# Copy to .env next to docker-compose.yml and edit before `docker compose up -d`.
# Compose reads this file automatically; it is excluded from the image build.

# Initial administrator password. Only used the first time the gateway starts
# (when the accounts database does not exist yet). Change it in the admin console
# afterwards.
DSH_GATEWAY_ADMIN_PASSWORD=change-me

# The address a BROWSER uses to reach this gateway, comma-separated. Required
# behind a bridge network: dsh refuses API calls from authorities it does not
# trust and can only see its own container interfaces. A port-less entry matches
# any port, so it survives a change of published port.
#
# List them here to avoid a one-time restart: an unknown hostname (say, a reverse
# proxy in front of this) is granted automatically the first time it is refused,
# which restarts that one account's dsh. Naming it here skips that.
DSH_GATEWAY_TRUSTED_HOSTS=192.168.100.1,home.example.com

# Port published on the Docker host. The container always listens on 8080.
DSH_GATEWAY_HOST_PORT=8080

# Concurrent dsh processes (memory bound) and how long an idle one lives.
DSH_GATEWAY_MAX_INSTANCES=8
DSH_GATEWAY_IDLE_MINUTES=30

# Timezone for dsh timestamps.
TZ=Asia/Shanghai
